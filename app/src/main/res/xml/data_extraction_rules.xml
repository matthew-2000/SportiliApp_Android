<data-extraction-rules>
    <cloud-backup>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    <exclude domain="sharedpref" path="native_surfaces.xml"/><exclude domain="sharedpref" path="surface_session.xml"/><exclude domain="sharedpref" path="workout_surface.xml"/></cloud-backup>
    <device-transfer><exclude domain="sharedpref" path="native_surfaces.xml"/><exclude domain="sharedpref" path="surface_session.xml"/><exclude domain="sharedpref" path="workout_surface.xml"/></device-transfer>
</data-extraction-rules>